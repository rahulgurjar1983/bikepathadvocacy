[Unit]
Description=Tell the owner by Telegram when the bike path loop stalls

[Service]
Type=oneshot
WorkingDirectory=%h/claude/bikepathadvocacy
Environment=PYTHONPATH=%h/claude/bikepathadvocacy/.ralph/control
ExecStart=/usr/bin/python3 -m gates.watchdog --restart "systemctl --user restart bikepath-loop.service"
